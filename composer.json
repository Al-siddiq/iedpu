{
    "name": "iedpu/north-zone-portal",
    "description": "IEDPU North Zone Digital Membership, Administration and Development Portal",
    "type": "project",
    "require": {
        "php": "^8.2.4",
        "codeigniter4/framework": "4.7.6",
        "codeigniter4/shield": "1.4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "check:environment": "php scripts/check-environment.php"
    }
}
