# IEDPU production profile. Copy to .env on production and replace every CHANGE_ME value.
# Production secrets must be generated and transferred through an approved secure channel.
# Never commit the resulting .env file.
CI_ENVIRONMENT = production

app.baseURL = 'https://www.example.invalid/'
app.indexPage = ''
app.appTimezone = 'Africa/Lagos'
app.forceGlobalSecureRequests = true

database.default.hostname = 'CHANGE_ME'
database.default.database = 'iedpu_production'
database.default.username = 'CHANGE_ME'
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.port = 3306

encryption.key = 'CHANGE_ME_WITH_A_RANDOM_32_BYTE_KEY'

cookie.secure = true
session.expiration = 7200

# P2-AUTH-02: separate 32-byte sodium key, base64 encoded; NEVER reuse encryption.key.
# Generate locally: C:\\xampp\\php\\php.exe -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Store the output only in the private .env / secret manager, not in Git or chat.
IEDPU_TOTP_KEY = 'CHANGE_ME_WITH_PRIVATE_BASE64_32_BYTE_KEY'

# Invitation delivery and incident reconciliation are disabled by default.
IEDPU_INVITATION_SMTP_ENABLED = 0
IEDPU_INVITATION_RECONCILE_ENABLED = 0
IEDPU_INVITATION_OUTBOX_KEY = 'CHANGE_ME_WITH_PRIVATE_BASE64_32_BYTE_KEY'
IEDPU_SMTP_HOST = 'CHANGE_ME'
IEDPU_SMTP_PORT = 587
IEDPU_SMTP_USER = 'CHANGE_ME'
IEDPU_SMTP_PASS = 'CHANGE_ME'
IEDPU_SMTP_FROM = 'CHANGE_ME'
IEDPU_PUBLIC_ORIGIN = 'https://CHANGE_ME'
